# Copy this file to .env and fill in real values there. .env is
# gitignored — it will never be committed or pushed. Never paste real
# keys into any .md file in this repo.

# Anthropic API key, only needed if an agent uses the API-key auth path
# instead of reusing the local Claude Code CLI subscription login.
ANTHROPIC_API_KEY=

# Stack-chan MCP bridge (github.com/migratorywhale/stackchan-mcp)
# One block per physical robot. Duplicate this section and give each a
# unique prefix (e.g. BRET_STACKCHAN_*, FAMILY_STACKCHAN_*) once we know
# how many units there are.
STACKCHAN_ROBOT_IP=
STACKCHAN_HOST_IP=
FISH_AUDIO_API_KEY=
